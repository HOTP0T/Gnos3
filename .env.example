# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ─── RAG retrieval tuning (Gnos3-K4mi-Nexa) ──────────────────────────────
# Defaults below match the values applied at deployment so retrieval works
# correctly for the modular stack (invoices, business cards, K4mi documents)
# across English, French, Japanese and Chinese. After first boot these are
# stored in webui.db (PersistentConfig) and can be tuned further via the
# Admin UI.

# Use a multilingual embedder served by Ollama (avoids the all-MiniLM-L6-v2
# default; qwen3-embedding handles CJK + Latin well).
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=qwen3-embedding:latest
RAG_OLLAMA_BASE_URL=http://localhost:11434

# Cross-encoder reranker. Auto-downloaded from HuggingFace on first boot
# (~2.3 GB on disk). Set HF_TOKEN below to lift the anonymous rate limit
# during that one-time download.
RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3

# Hybrid retrieval: vector + BM25, with the reranker scoring the union.
# top_k = candidates pulled by hybrid search; top_k_reranker = how many
# survive reranking and are passed to the LLM as context.
ENABLE_RAG_HYBRID_SEARCH=true
RAG_HYBRID_BM25_WEIGHT=0.5
RAG_TOP_K=20
RAG_TOP_K_RERANKER=10

# HuggingFace token. Optional — only speeds the one-time reranker download.
# Get a read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=